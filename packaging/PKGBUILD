# Maintainer: mops1k <https://github.com/mops1k>
pkgname=plasma-keyboard-custom
pkgver=6.7.90
pkgrel=3
pkgdesc="Virtual keyboard for Qt based desktops (custom fork with gamepad support)"
arch=('x86_64')
url="https://github.com/mops1k/plasma-keyboard-custom"
license=('GPL-2.0-or-later')
# Built against Qt 6.9 (Arch Linux Archive snapshot 2025-07-28) to match
# SteamOS 3.8, which ships Qt 6.9.1. The binaries carry the Qt_6.9 symbol
# version and use Qt's private Gui/WaylandClient ABI, which is only valid for
# the Qt minor they were built against, so the versioned Qt deps below reject
# an install on anything older than Qt 6.9. SteamOS 3.7 and older ship Qt 6.7
# or 6.8 and are no longer supported by this package (build locally there).
# Ship a single package: without this makepkg also produces a ~9 MB
# plasma-keyboard-custom-debug package (the Arch default enables debug), which
# only duplicates the symbols in every release asset and in the pacman
# repository. The build no longer depends on the local makepkg.conf defaults.
options=('!debug')
depends=(
  'glib2'
  'glibc'
  'kcmutils'
  'kconfig'
  'kcoreaddons'
  'kcrash'
  'kglobalaccel'
  'ki18n'
  'kirigami'
  'kirigami-addons'
  'kitemmodels'
  'layer-shell-qt'
  'libplasma'
  'libstdc++'
  'libxkbcommon'
  'qt6-base>=6.9.1'
  'qt6-declarative>=6.9.1'
  'qt6-multimedia>=6.9.1'
  'qt6-virtualkeyboard>=6.9.1'
  'qt6-wayland>=6.9.1'
  'wayland'
)
makedepends=(
  'cmake'
  'extra-cmake-modules'
  'gettext'
  'ninja'
  'plasma-wayland-protocols'
  'pkgconf'
  'qt6-wayland'
  'wayland-protocols'
)
# libhunspell is loaded while the application runs, so it stays optional: with
# it (and a dictionary) the spell checking and the corrections use the
# dictionaries of the system, without it everything works on the word lists
# compiled into the package.
# The voice input loads libvosk while the application runs, so vosk-api stays
# optional: with it the Vosk engine works, without it the other engines keep
# working. The models themselves are downloaded from the settings module.
optdepends=('hunspell: use the dictionaries of the system for the spelling and the corrections'
            'vosk-api: use the Vosk speech recognition engine')
# Deliberately no conflicts/replaces/provides: this package installs only
# custom-named files so it can be installed next to the official
# plasma-keyboard package. Choose it in System Settings -> Virtual Keyboard.
#
# The speech recognition engines come from whisper.cpp (MIT), which provides
# both Whisper and Parakeet. It is not a package dependency: the sources are
# built together with the keyboard, because the release is built against an
# Arch snapshot that does not ship whisper-cpp.
#
# The GigaAM engine comes from transcribe.cpp (MIT). It is built as a library
# of its own (libtranscribe.so, installed with the keyboard) because it
# vendors its own ggml, which cannot be linked into the same binary as the
# ggml whisper.cpp brings in.
_whisper_version=1.9.3
_transcribe_commit=5bb2deb2a4afb1fd50534ecb51cfcb521ef94944
source=("$pkgname-$pkgver.tar.gz"
        "whisper.cpp-$_whisper_version.tar.gz::https://github.com/ggml-org/whisper.cpp/archive/refs/tags/v$_whisper_version.tar.gz"
        "transcribe.cpp-$_transcribe_commit.tar.gz::https://github.com/handy-computer/transcribe.cpp/archive/$_transcribe_commit.tar.gz")
sha256sums=('SKIP'
            '1650f884effba487025143bd8facd2f9fb40a83b3737a732803c67a8d659d9c0'
            'c6491711a6eb3c44217118f20cdf3c9ce877d175e407c7a253a52e5c0c6a824d')

build() {
  cmake -B build -S "$pkgname-$pkgver" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
    -DKDE_INSTALL_LIBDIR=lib \
    -DWHISPER_CPP_SOURCE_DIR="$srcdir/whisper.cpp-$_whisper_version" \
    -DTRANSCRIBE_CPP_SOURCE_DIR="$srcdir/transcribe.cpp-$_transcribe_commit" \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
