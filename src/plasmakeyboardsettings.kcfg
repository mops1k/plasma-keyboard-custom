<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
    <kcfgfile name="plasmakeyboardrc" />
    <group name="General">
        <entry key="soundEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry key="vibrationEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry key="vibrationMs" type="Int">
            <default>10</default>
        </entry>
        <entry key="vibrationStrength" type="Int">
            <label>Strength of the vibration, in percent.</label>
            <default>75</default>
            <min>0</min>
            <max>100</max>
        </entry>
        <entry key="enabledLocales" type="StringList">
            <default></default>
        </entry>
        <entry key="defaultLocale" type="String">
            <label>Locale the keyboard opens with. Only an enabled locale has an effect; an empty value lets the system locale decide.</label>
            <default></default>
        </entry>
        <entry key="keyboardNavigationEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry key="autoCapitalizationEnabled" type="Bool">
            <label>Whether auto capitalization is enabled.</label>
            <default>true</default>
        </entry>
        <entry key="panelFillScreenWidth" type="Bool">
            <label>Whether the keyboard panel fills the screen width.</label>
            <default>true</default>
        </entry>
        <entry key="floatingKeyboard" type="Bool">
            <label>Whether the keyboard is a floating panel that can be moved around the screen.</label>
            <default>false</default>
        </entry>
        <entry key="floatingKeyboardX" type="Double">
            <label>Horizontal position of the floating keyboard as a fraction of the screen width. A negative value puts it in the middle.</label>
            <default>-1</default>
        </entry>
        <entry key="floatingKeyboardY" type="Double">
            <label>Vertical position of the floating keyboard as a fraction of the screen height. A negative value puts it at the bottom.</label>
            <default>-1</default>
        </entry>
        <entry key="floatingKeyboardWidthPercent" type="Int">
            <label>Width of the floating keyboard as a percentage of the screen width.</label>
            <min>20</min>
            <max>100</max>
            <default>80</default>
        </entry>
        <entry key="floatingKeyboardOpacity" type="Int">
            <label>Opacity of the floating keyboard as a percentage; 100 is fully opaque.</label>
            <min>20</min>
            <max>100</max>
            <default>100</default>
        </entry>
        <entry key="keyboardHeightPercent" type="Int">
            <label>Keyboard height as a percentage of the screen height.</label>
            <min>20</min>
            <max>80</max>
            <default>42</default>
        </entry>
        <entry key="showOnMouseFocus" type="Bool">
            <label>Whether the keyboard opens when a text field is focused with a mouse. When disabled it only opens on touch input or via the shortcut.</label>
            <default>false</default>
        </entry>
        <entry key="showOnLongTap" type="Bool">
            <label>Whether the keyboard opens only after a touch is held long enough, instead of opening immediately when a text field is focused.</label>
            <default>false</default>
        </entry>
        <entry key="showOnLongTapThresholdMs" type="Int">
            <label>How long a touch must be held for the keyboard to open, when showOnLongTap is enabled.</label>
            <min>100</min>
            <max>5000</max>
            <default>600</default>
        </entry>
        <entry key="showFunctionKeyRow" type="Bool">
            <label>Whether a row with the F1-F12 function keys is shown above the keyboard.</label>
            <default>false</default>
        </entry>
        <entry key="clipboardEnabled" type="Bool">
            <label>Whether the recent clipboard entries are shown above the keyboard.</label>
            <default>false</default>
        </entry>
        <entry key="hideOnInputFocusLoss" type="Bool">
            <label>Whether the keyboard is hidden when the text field loses the focus. When off, it is only hidden with its hide key.</label>
            <default>true</default>
        </entry>
        <entry key="hidePanelWhenKeyboardVisible" type="Bool">
            <label>Whether the Plasma panel is hidden while the keyboard is visible, so the keyboard reaches the bottom of the screen.</label>
            <default>true</default>
        </entry>
        <entry key="keyboardFontFamily" type="String">
            <label>Font family used to render the keyboard keys. An empty value uses the default font.</label>
            <default></default>
        </entry>
        <entry key="theme" type="String">
            <label>Visual theme used by the keyboard.</label>
            <default>system</default>
        </entry>
        <entry key="diacriticsPopupEnabled" type="Bool">
            <label>Whether holding a physical key shows diacritic options.</label>
            <default>true</default>
        </entry>
        <entry key="diacriticsHoldThresholdMs" type="Int">
            <label>Delay (ms) before showing diacritics when holding a physical key.</label>
            <min>100</min>
            <max>1500</max>
            <default>600</default>
        </entry>
        <entry key="gamepadAlternatesEnabled" type="Bool">
            <label>Whether holding the LT button on a gamepad opens the alternate characters of the highlighted key.</label>
            <default>true</default>
        </entry>
        <entry key="gamepadAlternatesThresholdMs" type="Int">
            <label>Delay (ms) before holding LT on a gamepad opens the alternate characters.</label>
            <min>100</min>
            <max>1500</max>
            <default>400</default>
        </entry>
        <entry key="predictiveTextEnabled" type="Bool">
            <label>Whether the words that continue what is being typed are offered above the keyboard.</label>
            <default>true</default>
        </entry>
        <entry key="predictiveSuggestionCount" type="Int">
            <label>How many word suggestions are offered at once.</label>
            <min>1</min>
            <max>5</max>
            <default>3</default>
        </entry>
        <entry key="predictiveMinPrefixLength" type="Int">
            <label>How many letters have to be typed before word suggestions are offered.</label>
            <min>1</min>
            <max>4</max>
            <default>1</default>
        </entry>
        <entry key="predictiveNextWordEnabled" type="Bool">
            <label>Whether the words that may follow the typed one are offered above the keyboard.</label>
            <default>true</default>
        </entry>
        <entry key="predictiveTypoCorrectionEnabled" type="Bool">
            <label>Whether a word that is not the beginning of any known word is offered to be corrected.</label>
            <default>true</default>
        </entry>
        <entry key="sttEnabled" type="Bool">
            <label>Whether voice input (local speech recognition) is available on the keyboard.</label>
            <default>false</default>
        </entry>
        <entry key="sttEngine" type="String">
            <label>Speech recognition engine: parakeet, whisper or vosk.</label>
            <default>parakeet</default>
        </entry>
        <entry key="sttModelPath" type="String">
            <label>Model used by the speech recognition. An empty value uses the model downloaded into the user's data directory.</label>
            <default></default>
        </entry>
        <entry key="sttLanguageMode" type="String">
            <label>Where the recognition language comes from: keyboard (the active layout) or fixed.</label>
            <default>keyboard</default>
        </entry>
        <entry key="sttLanguage" type="String">
            <label>Language used for the recognition when the language mode is fixed.</label>
            <default></default>
        </entry>
        <entry key="sttInputDevice" type="String">
            <label>Microphone used for the speech recognition. An empty value uses the default input device.</label>
            <default></default>
        </entry>
    </group>
</kcfg>
