[Desktop Entry]
Name=plasma-keyboard-custom
Exec=plasma-keyboard-custom
Type=Application
X-KDE-Wayland-VirtualKeyboard=true
X-KDE-Wayland-Interfaces=kde_lockscreen_overlay_v1
Icon=input-keyboard-virtual
NoDisplay=true
