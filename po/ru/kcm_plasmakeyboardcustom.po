msgstr "Parakeet v3 определяет язык сама; остальные движки используют эту настройку."

#: ui/SttSettingsPage.qml
msgid "Follow the keyboard layout"
msgstr "Как в раскладке клавиатуры"

#: ui/SttSettingsPage.qml
msgid "Always use one language"
msgstr "Всегда один язык"

#: ui/SttSettingsPage.qml
msgid "Recognition language:"
msgstr "Язык распознавания:"

#: ui/SttSettingsPage.qml
msgid "Remove the model"
msgstr "Удаление модели"

#: ui/SttSettingsPage.qml
msgid "Remove “%1” from the disk? The voice input cannot use it until it is downloaded again."
msgstr "Удалить «%1» с диска? Голосовой ввод не сможет её использовать, пока она не будет скачана снова."

#: plasmakeyboardkcm.cpp
msgid "Unknown model."
msgstr "Неизвестная модель."

#: sttmodeldownloader.cpp
msgid "Cannot create “%1”."
msgstr "Не удалось создать «%1»."

#: sttmodeldownloader.cpp
msgid "Cannot write to “%1”."
msgstr "Не удалось записать в «%1»."

#: sttmodeldownloader.cpp
msgid "The download was cancelled."
msgstr "Скачивание отменено."

#: sttmodeldownloader.cpp
msgid "The download of “%1” is empty."
msgstr "Скачанный файл «%1» пуст."

#: sttmodeldownloader.cpp
msgid "The download of “%1” has the wrong size (%2 instead of %3 bytes)."
msgstr "У «%1» неверный размер (получено %2 вместо %3 байт)."

#: sttmodeldownloader.cpp
msgid "Cannot read the downloaded model “%1”."
msgstr "Не удалось прочитать скачанную модель «%1»."

#: sttmodeldownloader.cpp
msgid "The download of “%1” is damaged (checksum mismatch)."
msgstr "Скачанная модель «%1» повреждена (не совпала контрольная сумма)."

#: sttmodeldownloader.cpp
msgid "The downloaded archive “%1” cannot be read."
msgstr "Не удалось прочитать скачанный архив «%1»."

#: sttmodeldownloader.cpp
msgid "Cannot unpack “%1” into “%2”."
msgstr "Не удалось распаковать «%1» в «%2»."

#: sttmodeldownloader.cpp
msgid "Cannot move the downloaded model to “%1”."
msgstr "Не удалось переместить скачанную модель в «%1»."
