[Unit]
Description=Use Plasma Keyboard on the lock screen and the custom keyboard in the session
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=@KDE_INSTALL_FULL_LIBEXECDIR@/plasma-keyboard-lock-switcher @KDE_INSTALL_FULL_APPDIR@/org.kde.plasma.keyboard.custom.desktop @KDE_INSTALL_FULL_APPDIR@/org.kde.plasma.keyboard.desktop
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
