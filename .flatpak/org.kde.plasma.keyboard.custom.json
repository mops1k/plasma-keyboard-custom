{
    "$schema": "https://raw.githubusercontent.com/flatpak/flatpak-builder/main/data/flatpak-manifest.schema.json",
    "id": "org.kde.plasma.keyboard.custom",
    "branch": "stable",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.10",
    "sdk": "org.kde.Sdk",
    "command": "plasma-keyboard-custom",
    "finish-args": [
        "--share=ipc",
        "--device=dri",
        "--socket=wayland",
        "--socket=inherit-wayland-socket",
        "--env=QML2_IMPORT_PATH=/app/qml:/app/lib/qml:/app/lib64/qml",
        "--env=QT_PLUGIN_PATH=/app/plugins:/app/lib64/plugins:/app/lib/plugins:/usr/share/runtime/lib/plugins"
    ],
    "modules": [
        {
            "name": "qt6-virtualkeyboard",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DQT_DISABLE_RPATH=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.kde.org/qt/official_releases/qt/6.10/6.10.3/submodules/qtvirtualkeyboard-everywhere-src-6.10.3.tar.xz",
                    "sha256": "3298e26dfa4fad2363e3dfb2b55079c54fc8115a4a040d9616e5619f095d8fb5"
                }
            ]
        },
        {
            "name": "plasma-activities",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DBUILD_TESTING=OFF"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://invent.kde.org/plasma/plasma-activities.git",
                    "tag": "v6.7.5"
                }
            ]
        },
        {
            "name": "libplasma",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DBUILD_TESTING=OFF"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://invent.kde.org/plasma/libplasma.git",
                    "tag": "v6.7.5"
                }
            ]
        },
        {
            "name": "layer-shell-qt",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DBUILD_TESTING=OFF"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://invent.kde.org/plasma/layer-shell-qt.git",
                    "tag": "v6.7.5"
                }
            ]
        },
        {
            "name": "plasma-keyboard-custom",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DBUILD_TESTING=OFF",
                "-DWHISPER_CPP_SOURCE_DIR=whisper-cpp/whisper.cpp-1.9.3",
                "-DTRANSCRIBE_CPP_SOURCE_DIR=transcribe-cpp/transcribe.cpp-5bb2deb2a4afb1fd50534ecb51cfcb521ef94944"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "..",
                    "skip": [
                        ".git",
                        ".dsh",
                        "build",
                        "build-*",
                        "packaging/*.tar.gz"
                    ]
                },
                {
                    "type": "archive",
                    "url": "https://github.com/ggml-org/whisper.cpp/archive/refs/tags/v1.9.3.tar.gz",
                    "sha256": "1650f884effba487025143bd8facd2f9fb40a83b3737a732803c67a8d659d9c0",
                    "strip-components": 0,
                    "dest": "whisper-cpp"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/handy-computer/transcribe.cpp/archive/5bb2deb2a4afb1fd50534ecb51cfcb521ef94944.tar.gz",
                    "sha256": "c6491711a6eb3c44217118f20cdf3c9ce877d175e407c7a253a52e5c0c6a824d",
                    "strip-components": 0,
                    "dest": "transcribe-cpp"
                }
            ]
        }
    ]
}
